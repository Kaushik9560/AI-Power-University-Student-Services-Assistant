# ---- LLM: Ollama is the primary model (guide §5). Pull it BEFORE the event: `ollama pull llama3.1:8b`
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_S=120
# Deterministic stand-in for tests/evaluation and as the last-resort fallback during the demo.
MOCK_LLM=false
MOCK_FALLBACK=true
# Cloud model used ONLY if Ollama fails and this is true (disclosed in README).
CLOUD_FALLBACK=false
CLOUD_PROVIDER=openai
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini

# ---- Embeddings / retrieval
EMBEDDING_PROVIDER=minilm          # minilm | bge | hash (offline tests only)
RETRIEVAL_TOP_K=8
EVIDENCE_MAX_CHUNKS=5
RETRIEVAL_MAX_DISTANCE=0.75
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150
OCR_ENABLED=true                   # tesseract + poppler required; launcher supports project-local OCR
TOOL_PLANNING=true                 # bounded LLM tool proposal; code validates and executes it

# ---- Paths
CHROMA_DIR=data/chroma/nsut
CHROMA_COLLECTION=nsut_docs
SQLITE_PATH=data/nsut.db
AUDIT_DB_PATH=data/nsut-audit.db
SOURCE_REGISTER=data/nsut/source_register.csv
DOCUMENTS_DIR=data/nsut/documents
# All student identities, attendance and results remain fictional test data.
SYNTHETIC_DIR=data/nsut/synthetic
RULE_REGISTRY_PATH=data/nsut/rule_registry.csv

# ---- API / UI
API_PORT=8000
API_BASE_URL=http://localhost:8000
DEFAULT_STUDENT_ID=S1001

# Existing RAG integration configuration
APP_NAME=University Student Services Assistant
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/students.db
CHROMA_PATH=data/chroma
SOURCE_REGISTER_DB=data/source-register.db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=gpt-4.1-mini
