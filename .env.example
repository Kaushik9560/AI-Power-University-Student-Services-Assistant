# SHARED FILE: coordinate before editing.
APP_NAME=University Student Services Assistant
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/students.db
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=university_docs
SOURCE_REGISTER_DB=data/source-register.db
SOURCE_REGISTER=data/source_register.csv
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_DISTANCE=0.75
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150
EMBEDDING_PROVIDER=minilm
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OCR_ENABLED=false
LLM_MODEL=gpt-4.1-mini
